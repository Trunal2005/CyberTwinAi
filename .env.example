DATABASE_URL=sqlite:///./data/cybertwin.db
ADMIN_USERNAME=
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
# Explicitly enable only in an isolated Linux lab. Never needed for simulation.
REAL_ENFORCEMENT=false
FIREWALL_ADAPTER=simulated
PROTECTED_CIDRS=127.0.0.0/8,::1/128,10.10.0.0/24
ALLOWLIST=
# Server-owned local EVE log, not an uploaded file. Live mode requires fresh records.
SURICATA_EVE_PATH=
SURICATA_LIVE_CONFIRMED=false
MODEL_PATH=./data/model.joblib
